# OrderCore API base URL. Defaults to the API served by the OrderCore repo's
# `docker compose up -d` (see "Backend / API contract" in CLAUDE.md).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Demonstration-store notice (band above the header + test-card hint on
# Pagamento). On unless set to `false`; turn it off together with Stripe's
# live keys.
NEXT_PUBLIC_DEMO_STORE=true

# Server-side address of the OrderCore API, used by the session routes
# (src/app/api/session/*). Optional: falls back to NEXT_PUBLIC_API_URL. Set it
# when the server reaches the API on a different address than the browser.
# ORDERCORE_API_URL=http://localhost:8080
